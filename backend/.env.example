# Copy this file to .env and fill in real values before running.

# Database: defaults to local SQLite file. For production, use a free permanent
# Postgres instance from Neon (https://neon.tech) and paste its connection string here.
# (Not Render's own Postgres — that auto-deletes after 30 days. See DEPLOY-FREE-ONLINE.md.)
DATABASE_URL=sqlite:///./nora.db

# Telegram bot token from @BotFather (see DEPLOY-FREE-ONLINE.md for steps)
TELEGRAM_BOT_TOKEN=

# Telegram chat id for the admin ALERT channel (spec section 6: stock mismatches,
# stalled deliveries). Create a Telegram group/channel, add the bot as admin, and
# put its numeric chat id here. Leave blank to disable admin push alerts.
ADMIN_TELEGRAM_CHAT_ID=

# WhatsApp Cloud API - from Meta App Dashboard > WhatsApp > API Setup (see DEPLOY-FREE-ONLINE.md)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=nora-verify-me

# Admin dashboard login (HTTP Basic Auth) - change these before going live
ADMIN_USER=admin
ADMIN_PASS=changeme

# CORS: comma-separated list of allowed origins for the browser dashboard / web app.
# Use "*" only for local dev. In production set your real domain(s), e.g.
# https://nora-abc123.onrender.com
ALLOWED_ORIGINS=*

# Optional pricing overrides (defaults match the spec's sample conversation:
# gas 12kg = 1,700 ETB, delivery = 150 ETB, total = 1,850 ETB).
NORA_DELIVERY_FEE=150
NORA_DEFAULT_ETA_MINUTES=45
